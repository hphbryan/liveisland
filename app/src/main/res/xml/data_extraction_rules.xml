<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the settings (apps turned on, people, words, per-app choices) are backed up and moved to a new phone.
  Not: samples (notification text), recent senders, kinds of notifications seen, what was dismissed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
