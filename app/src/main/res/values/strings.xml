    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy">No internet permission, no analytics, no ads. Notifications are read on your phone to decide what to show. Kept on the phone: recent sender names (to pick people from) and, only while you record samples, notification text. Turning an app off or clearing samples deletes them.</string>
    <string name="about_license_title">License</string>
    <string name="about_license">Apache License 2.0. Built with Jetpack Compose and AndroidX, also under Apache License 2.0.</string>
    <string name="about_limits_title">Known limits</string>
    <string name="about_limits">The source app\'s own notification stays in the shade. Notifications drawn with custom layouts cannot be read. Samsung\'s expanded card header always names LiveIsland as the sender.</string>

